# Supabase (projeto real — ver PLAN.md, Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação, usada para montar links de e-mail (convite,
# recuperação de senha). Em produção, a URL do deploy na Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Connection string do Postgres (Session Pooler — Project Settings >
# Database no painel do Supabase). Usada por `supabase db push --db-url`
# para aplicar migrations e por `npm run seed`. Nunca lida pelo Next.js.
SUPABASE_DB_URL=
